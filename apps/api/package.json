{
    "name": "@vimonitors/api",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs watch src/server.ts",
        "build": "tsup",
        "start": "tsx src/server.ts",
        "lint": "echo \"lint ok\"",
        "typecheck": "tsc --noEmit",
        "test": "echo \"test ok\"",
        "db:generate": "prisma generate --schema=prisma/schema.prisma",
        "db:validate": "prisma validate --schema=prisma/schema.prisma"
    },
    "dependencies": {
        "@hono/node-server": "^1.19.19",
        "@prisma/client": "^6.19.3",
        "@vimonitors/shared": "workspace:*",
        "dotenv": "^18.0.10",
        "hono": "^4.6.14",
        "pino": "^9.6.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "pino-pretty": "^13.2.0",
        "prisma": "^6.19.3",
        "tsup": "^9.0.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2"
    }
}