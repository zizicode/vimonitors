{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
      "lib": ["ES2022", "DOM", "DOM.Iterable"],
      "allowJs": true,
      "noEmit": true,
      "incremental": true,
      "jsx": "preserve",
      "plugins": [
        {
          "name": "next"
        }
      ],
      "paths": {
        "@/*": ["./src/*"]
      }
    },
    "include": ["next-env.d.ts", "src/**/*", ".next/types/**/*.ts"],
    "exclude": ["node_modules"]
  }